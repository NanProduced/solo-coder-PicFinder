# ========================================
# PicFinder 智能图片搜索应用配置
# ========================================

# ------------------------------
# 文本LLM配置 (OpenAI 兼容协议)
# 用于理解用户自然语言描述，生成更精准的搜索关键词
#
# 注意：如果使用的模型会输出 <think> 思考过程标签（如 Qwen、DeepSeek 等）
# 代码已自动处理这种情况，会正确提取 JSON 部分
# ------------------------------
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=your-openai-compatible-api-key
OPENAI_COMPATIBLE_MODEL=gpt-4o

# ------------------------------
# 阿里云百炼多模态Embedding配置
# 用于计算图文相似度，筛选相关图片
#
# ⚠️ 重要说明：
# 阿里云百炼多模态embedding不走OpenAI兼容协议
# 需要使用 DashScope 原生 API
#
# 推荐模型选择：
# - qwen3-vl-embedding (推荐)：最新模型，支持融合向量和独立向量，维度2560
# - tongyi-embedding-vision-plus-2026-03-06：较新模型
# - multimodal-embedding-v1：旧版模型（不推荐）
#
# 文档参考: https://help.aliyun.com/zh/model-studio/developer-reference/multimodal-embedding
# ------------------------------
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_MULTIMODAL_EMBEDDING_MODEL=qwen3-vl-embedding
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# ------------------------------
# Pexels API配置
# 申请地址: https://www.pexels.com/api/new/
# 限流: 每小时 200 次请求
# ------------------------------
PEXELS_API_KEY=your-pexels-api-key

# ------------------------------
# Unsplash API配置
# 申请地址: https://unsplash.com/oauth/applications
# 限流: Demo模式每小时 50 次请求
# ------------------------------
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
UNSPLASH_SECRET_KEY=your-unsplash-secret-key

# ------------------------------
# 应用配置
# ------------------------------
NEXT_PUBLIC_APP_NAME=PicFinder
NEXT_PUBLIC_APP_DESCRIPTION=AI智能图片搜索
